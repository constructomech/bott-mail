# bott-mail secrets (copy to .env; never commit the real .env)

# Service tokens. Generate with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
BOTT_MAIL_HERMES_READ_TOKEN=replace-with-random-token

# Token scoped only to archive actions. Do not give this to Hermes for
# read-only access.
BOTT_MAIL_ARCHIVE_TOKEN=replace-with-different-random-token

# Token for Hermes to submit dry-run automation recommendations.
BOTT_MAIL_AUTOMATION_TOKEN=replace-with-automation-random-token

# HMAC secret for bott-mail -> Hermes classification webhooks.
BOTT_MAIL_HERMES_WEBHOOK_SECRET=replace-with-hermes-webhook-secret

# Proton Bridge IMAP credentials — the BRIDGE credentials from `info`,
# NOT your Proton account password. Owned by the bott-mail container only.
PROTON_BRIDGE_IMAP_USERNAME=replace-with-bridge-username
PROTON_BRIDGE_IMAP_PASSWORD=replace-with-bridge-password
